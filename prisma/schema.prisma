// Infinity Ops Studio — database schema
// Every tenant-owned table carries `workspaceId` and is indexed on it.
// Services must always scope queries by workspace (see src/server/tenant.ts).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identity ───────────────────────────────

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  name              String
  passwordHash      String?
  avatarUrl         String?
  emailVerifiedAt   DateTime?
  platformRole      PlatformRole @default(USER)
  status            UserStatus   @default(ACTIVE)
  twoFactorEnabled  Boolean      @default(false)
  twoFactorSecret   String? // AES-256-GCM encrypted
  recoveryCodes     String[] // sha256 hashes of unused recovery codes
  failedLoginCount  Int          @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  lastWorkspaceId   String?
  notificationPrefs Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  sessions           Session[]
  oauthAccounts      OAuthAccount[]
  verificationTokens VerificationToken[]
  memberships        WorkspaceMember[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  createdTasks       AITask[]            @relation("TaskCreatedBy")
  approvedTasks      AITask[]            @relation("TaskApprovedBy")
  ownedCampaigns     Campaign[]          @relation("CampaignOwner")
  contents           Content[]
  ownedLeads         Lead[]              @relation("LeadOwner")
  aiRequests         AIRequest[]
  conversations      AIConversation[]

  @@index([createdAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  // Hash of the token this one replaced. Presenting it again signals token theft.
  previousTokenHash String?   @unique
  rememberMe        Boolean   @default(false)
  twoFactorPending  Boolean   @default(false)
  ip                String?
  userAgent         String?
  expiresAt         DateTime
  rotatedAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_RECOVERY
}

model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  type      VerificationTokenType
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─────────────────────────────── Tenancy ───────────────────────────────

model Workspace {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  industry  String?
  website   String?
  timezone  String    @default("UTC")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members        WorkspaceMember[]
  invites        WorkspaceInvite[]
  roles          Role[]
  subscription   Subscription?
  invoices       Invoice[]
  usageRecords   UsageRecord[]
  workers        AIWorker[]
  tasks          AITask[]
  aiRequests     AIRequest[]
  conversations  AIConversation[]
  campaigns      Campaign[]
  campaignTasks  CampaignTask[]
  contents       Content[]
  socialAccounts SocialAccount[]
  socialPosts    SocialPost[]
  seoProjects    SEOProject[]
  keywords       Keyword[]
  leads          Lead[]
  leadActivities LeadActivity[]
  leadTasks      LeadTask[]
  workflows      Workflow[]
  workflowRuns   WorkflowExecution[]
  emailCampaigns EmailCampaign[]
  emailTemplates EmailTemplate[]
  emailSends     EmailSend[]
  brandKit       BrandKit?
  integrations   Integration[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  metrics        MetricDaily[]
  files          File[]
}

model Role {
  id          String            @id @default(cuid())
  // null => built-in system role shared by all workspaces
  workspaceId String?
  key         String
  name        String
  description String?
  permissions String[]
  rank        Int               @default(0)
  isSystem    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invites     WorkspaceInvite[]

  @@unique([workspaceId, key])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  roleId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  roleId      String
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id])

  @@index([workspaceId])
  @@index([email])
}

// ─────────────────────────────── Billing ───────────────────────────────

enum PlanKey {
  FREE
  STARTER
  GROWTH
  SCALE
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Subscription {
  id                     String             @id @default(cuid())
  workspaceId            String             @unique
  plan                   PlanKey            @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  interval               BillingInterval    @default(MONTHLY)
  provider               String             @default("manual")
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  seats                  Int                @default(1)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  pendingPlan            PlanKey?
  trialEndsAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  workspace              Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices               Invoice[]
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model Invoice {
  id                String        @id @default(cuid())
  workspaceId       String
  subscriptionId    String?
  number            String        @unique
  amountCents       Int
  taxCents          Int           @default(0)
  currency          String        @default("USD")
  status            InvoiceStatus @default(OPEN)
  description       String?
  lineItems         Json
  provider          String        @default("manual")
  providerInvoiceId String?
  hostedUrl         String?
  periodStart       DateTime
  periodEnd         DateTime
  issuedAt          DateTime      @default(now())
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, issuedAt])
}

enum UsageMetric {
  AI_CREDITS
  AI_TOKENS
  EMAILS_SENT
  SOCIAL_POSTS
  CONTENT_ITEMS
  STORAGE_BYTES
}

model UsageRecord {
  id          String      @id @default(cuid())
  workspaceId String
  userId      String?
  metric      UsageMetric
  quantity    Int
  period      String // YYYY-MM
  refType     String?
  refId       String?
  createdAt   DateTime    @default(now())
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, metric, period])
  @@index([createdAt])
}

// ─────────────────────────────── AI ───────────────────────────────

model AIWorker {
  id                 String           @id @default(cuid())
  workspaceId        String
  key                String
  name               String
  title              String
  description        String
  color              String           @default("#6366f1")
  capabilities       String[]
  systemPrompt       String
  customInstructions String?
  provider           String?
  model              String?
  temperature        Float            @default(0.7)
  requiresApproval   Boolean          @default(true)
  isActive           Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks              AITask[]
  conversations      AIConversation[]
  campaignTasks      CampaignTask[]

  @@unique([workspaceId, key])
}

enum AITaskStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  FAILED
  CANCELLED
}

model AITask {
  id               String       @id @default(cuid())
  workspaceId      String
  workerId         String
  createdById      String?
  campaignId       String?
  title            String
  capability       String
  instructions     String
  input            Json?
  status           AITaskStatus @default(QUEUED)
  output           String?
  error            String?
  attempts         Int          @default(0)
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  costMicros       Int          @default(0)
  model            String?
  provider         String?
  reviewNote       String?
  approvedById     String?
  approvedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  worker           AIWorker     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdBy        User?        @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy       User?        @relation("TaskApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  campaign         Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workerId, createdAt])
}

enum AIRequestStatus {
  SUCCESS
  ERROR
}

// Audit trail for every model call — also the source of truth for cost tracking.
model AIRequest {
  id               String          @id @default(cuid())
  workspaceId      String?
  userId           String?
  taskId           String?
  feature          String
  provider         String
  model            String
  promptTokens     Int             @default(0)
  completionTokens Int             @default(0)
  costMicros       Int             @default(0)
  latencyMs        Int             @default(0)
  status           AIRequestStatus
  errorMessage     String?
  promptPreview    String?
  createdAt        DateTime        @default(now())
  workspace        Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

model AIConversation {
  id          String      @id @default(cuid())
  workspaceId String
  userId      String?
  workerId    String?
  title       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  worker      AIWorker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  messages    AIMessage[]

  @@index([workspaceId, userId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String // system | user | assistant
  content        String
  tokens         Int            @default(0)
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─────────────────────────────── Campaigns ───────────────────────────────

enum CampaignStatus {
  DRAFT
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignObjective {
  AWARENESS
  TRAFFIC
  ENGAGEMENT
  LEADS
  CONVERSIONS
  SALES
  RETENTION
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model Campaign {
  id             String            @id @default(cuid())
  workspaceId    String
  ownerId        String?
  name           String
  description    String?
  objective      CampaignObjective @default(AWARENESS)
  status         CampaignStatus    @default(DRAFT)
  approvalStatus ApprovalStatus    @default(NOT_REQUIRED)
  targetAudience String?
  budgetCents    Int               @default(0)
  spentCents     Int               @default(0)
  currency       String            @default("USD")
  startDate      DateTime?
  endDate        DateTime?
  channels       String[]
  strategy       String?
  kpis           Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User?             @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks          CampaignTask[]
  aiTasks        AITask[]
  contents       Content[]
  socialPosts    SocialPost[]
  emailCampaigns EmailCampaign[]
  leads          Lead[]
  metrics        MetricDaily[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model CampaignTask {
  id          String     @id @default(cuid())
  workspaceId String
  campaignId  String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  assigneeId  String?
  workerId    String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  worker      AIWorker?  @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([campaignId, sortOrder])
}

// ─────────────────────────────── Content ───────────────────────────────

enum ContentType {
  BLOG_POST
  SOCIAL_POST
  AD_COPY
  LANDING_PAGE
  EMAIL
  PRODUCT_DESCRIPTION
  SEO_META
  OTHER
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model Content {
  id            String           @id @default(cuid())
  workspaceId   String
  authorId      String?
  campaignId    String?
  title         String
  type          ContentType
  status        ContentStatus    @default(DRAFT)
  body          String           @default("")
  tone          String?
  excerpt       String?
  keywords      String[]
  generatedByAI Boolean          @default(false)
  wordCount     Int              @default(0)
  shareToken    String?          @unique
  publishedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author        User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  campaign      Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  versions      ContentVersion[]
  socialPosts   SocialPost[]

  @@index([workspaceId, type])
  @@index([workspaceId, updatedAt])
}

model ContentVersion {
  id          String   @id @default(cuid())
  contentId   String
  version     Int
  title       String
  body        String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
}

// ─────────────────────────────── Social ───────────────────────────────

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  X
  YOUTUBE
  TIKTOK
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model SocialAccount {
  id             String           @id @default(cuid())
  workspaceId    String
  platform       SocialPlatform
  handle         String
  displayName    String?
  externalId     String?
  status         ConnectionStatus @default(CONNECTED)
  accessToken    String? // encrypted
  refreshToken   String? // encrypted
  tokenExpiresAt DateTime?
  followers      Int              @default(0)
  connectedById  String?
  lastSyncAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts          SocialPost[]

  @@unique([workspaceId, platform, handle])
}

enum SocialPostStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model SocialPost {
  id              String           @id @default(cuid())
  workspaceId     String
  socialAccountId String?
  campaignId      String?
  contentId       String?
  platform        SocialPlatform
  text            String
  mediaUrls       String[]
  hashtags        String[]
  status          SocialPostStatus @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  externalPostId  String?
  externalUrl     String?
  impressions     Int              @default(0)
  reach           Int              @default(0)
  likes           Int              @default(0)
  comments        Int              @default(0)
  shares          Int              @default(0)
  clicks          Int              @default(0)
  error           String?
  createdById     String?
  approvedById    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount?   @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  campaign        Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  content         Content?         @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
}

// ─────────────────────────────── SEO ───────────────────────────────

model SEOProject {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  domain      String
  score       Int?
  auditResult Json?
  lastAuditAt DateTime?
  competitors String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  keywords    Keyword[]

  @@index([workspaceId])
}

enum KeywordStatus {
  TRACKING
  OPPORTUNITY
  ARCHIVED
}

model Keyword {
  id               String        @id @default(cuid())
  workspaceId      String
  projectId        String
  term             String
  searchVolume     Int           @default(0)
  difficulty       Int           @default(0)
  cpcCents         Int           @default(0)
  intent           String?
  position         Int?
  previousPosition Int?
  targetUrl        String?
  status           KeywordStatus @default(TRACKING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          SEOProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, term])
  @@index([workspaceId, status])
}

// ─────────────────────────────── Email ───────────────────────────────

model EmailTemplate {
  id             String          @id @default(cuid())
  workspaceId    String
  name           String
  category       String          @default("general")
  subject        String
  previewText    String?
  body           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailCampaigns EmailCampaign[]

  @@index([workspaceId])
}

enum EmailCampaignType {
  BROADCAST
  SEQUENCE
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  ACTIVE
  PAUSED
  CANCELLED
  FAILED
}

model EmailCampaign {
  id               String              @id @default(cuid())
  workspaceId      String
  campaignId       String?
  templateId       String?
  name             String
  type             EmailCampaignType   @default(BROADCAST)
  status           EmailCampaignStatus @default(DRAFT)
  subject          String
  previewText      String?
  body             String
  fromName         String?
  // Segment filter: { statuses?: LeadStatus[], tags?: string[], minScore?: number, sources?: LeadSource[] }
  segment          Json?
  // Sequence steps: [{ delayDays, subject, body }]
  steps            Json?
  scheduledAt      DateTime?
  sentAt           DateTime?
  recipientsCount  Int                 @default(0)
  deliveredCount   Int                 @default(0)
  openCount        Int                 @default(0)
  clickCount       Int                 @default(0)
  conversionCount  Int                 @default(0)
  unsubscribeCount Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign         Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  template         EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sends            EmailSend[]

  @@index([workspaceId, status])
}

enum EmailSendStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
}

model EmailSend {
  id              String          @id @default(cuid())
  workspaceId     String
  emailCampaignId String
  leadId          String?
  email           String
  step            Int             @default(0)
  status          EmailSendStatus @default(QUEUED)
  trackingToken   String          @unique
  error           String?
  sentAt          DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  convertedAt     DateTime?
  createdAt       DateTime        @default(now())
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailCampaign   EmailCampaign   @relation(fields: [emailCampaignId], references: [id], onDelete: Cascade)
  lead            Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([emailCampaignId, leadId, step])
  @@index([workspaceId, createdAt])
}

// ─────────────────────────────── Leads ───────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  SOCIAL
  EMAIL
  ADS
  REFERRAL
  EVENT
  IMPORT
  MANUAL
  API
}

model Lead {
  id              String         @id @default(cuid())
  workspaceId     String
  ownerId         String?
  campaignId      String?
  firstName       String
  lastName        String?
  email           String?
  phone           String?
  company         String?
  jobTitle        String?
  website         String?
  source          LeadSource     @default(MANUAL)
  status          LeadStatus     @default(NEW)
  score           Int            @default(0)
  tags            String[]
  valueCents      Int            @default(0)
  lastContactedAt DateTime?
  unsubscribedAt  DateTime?
  customFields    Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  campaign        Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  activities      LeadActivity[]
  tasks           LeadTask[]
  emailSends      EmailSend[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, score])
}

enum LeadActivityType {
  CREATED
  NOTE
  STATUS_CHANGE
  SCORE_CHANGE
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  CALL
  MEETING
  TASK
  IMPORTED
  WORKFLOW
}

model LeadActivity {
  id          String           @id @default(cuid())
  workspaceId String
  leadId      String
  actorId     String?
  type        LeadActivityType
  content     String
  metadata    Json?
  createdAt   DateTime         @default(now())
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadTask {
  id          String    @id @default(cuid())
  workspaceId String
  leadId      String
  title       String
  dueDate     DateTime?
  completedAt DateTime?
  assigneeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// ─────────────────────────────── Automation ───────────────────────────────

enum WorkflowTrigger {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  CONTENT_PUBLISHED
  CAMPAIGN_COMPLETED
  ENGAGEMENT_LOW
  SCHEDULE
  WEBHOOK
  MANUAL
}

model Workflow {
  id            String              @id @default(cuid())
  workspaceId   String
  name          String
  description   String?
  isEnabled     Boolean             @default(false)
  trigger       WorkflowTrigger
  triggerConfig Json?
  webhookToken  String?             @unique
  runCount      Int                 @default(0)
  lastRunAt     DateTime?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodes         WorkflowNode[]
  executions    WorkflowExecution[]

  @@index([workspaceId, trigger, isEnabled])
}

enum WorkflowNodeType {
  CONDITION
  DELAY
  AI_ACTION
  SEND_EMAIL
  CREATE_SOCIAL_POST
  UPDATE_LEAD
  ASSIGN_WORKER
  WEBHOOK
  NOTIFY
  GENERATE_REPORT
}

model WorkflowNode {
  id         String           @id @default(cuid())
  workflowId String
  type       WorkflowNodeType
  label      String
  config     Json
  position   Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  workflow   Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, position])
}

enum ExecutionStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
  STOPPED
}

model WorkflowExecution {
  id          String          @id @default(cuid())
  workspaceId String
  workflowId  String
  status      ExecutionStatus @default(RUNNING)
  payload     Json?
  context     Json?
  logs        Json            @default("[]")
  currentStep Int             @default(0)
  error       String?
  resumeAt    DateTime?
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow    Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, startedAt])
  @@index([workspaceId, status])
}

// ─────────────────────────────── Brand & integrations ───────────────────────────────

model BrandKit {
  id               String    @id @default(cuid())
  workspaceId      String    @unique
  companyName      String
  tagline          String?
  logoUrl          String?
  website          String?
  industry         String?
  primaryColor     String    @default("#6366f1")
  secondaryColor   String    @default("#0ea5e9")
  accentColor      String    @default("#f59e0b")
  headingFont      String    @default("Inter")
  bodyFont         String    @default("Inter")
  voice            String?
  voiceAttributes  String[]
  targetAudience   String?
  productsServices String?
  usps             String[]
  competitors      String[]
  guidelines       String?
  dos              String[]
  donts            String[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Integration {
  id            String           @id @default(cuid())
  workspaceId   String
  provider      String
  category      String
  status        ConnectionStatus @default(CONNECTED)
  config        Json?
  credentials   String? // encrypted JSON blob
  connectedById String?
  lastSyncAt    DateTime?
  error         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

// ─────────────────────────────── Analytics ───────────────────────────────

enum MetricChannel {
  WEBSITE
  SOCIAL
  EMAIL
  ADS
  SEO
}

// Daily rollups written by analytics sync jobs.
model MetricDaily {
  id           String        @id @default(cuid())
  workspaceId  String
  campaignId   String?
  date         DateTime      @db.Date
  channel      MetricChannel
  impressions  Int           @default(0)
  reach        Int           @default(0)
  visits       Int           @default(0)
  clicks       Int           @default(0)
  engagements  Int           @default(0)
  leads        Int           @default(0)
  conversions  Int           @default(0)
  revenueCents Int           @default(0)
  spendCents   Int           @default(0)
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId, date])
  @@index([workspaceId, channel, date])
  @@index([campaignId, date])
}

// ─────────────────────────────── Platform ───────────────────────────────

model Notification {
  id          String     @id @default(cuid())
  workspaceId String?
  userId      String
  type        String
  title       String
  body        String?
  link        String?
  readAt      DateTime?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id          String     @id @default(cuid())
  workspaceId String?
  actorId     String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  description    String?
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100)
  workspaceIds   String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  source    String
  message   String
  context   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
}

enum FileVisibility {
  PRIVATE
  PUBLIC
}

model File {
  id           String         @id @default(cuid())
  workspaceId  String
  uploadedById String?
  key          String         @unique
  filename     String
  mimeType     String
  size         Int
  visibility   FileVisibility @default(PRIVATE)
  purpose      String         @default("asset")
  createdAt    DateTime       @default(now())
  deletedAt    DateTime?
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ─────────────────────────────── Public site ───────────────────────────────

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String
  body           String
  category       String
  tags           String[]
  authorName     String
  authorRole     String?
  coverImage     String?
  readingMinutes Int       @default(5)
  featured       Boolean   @default(false)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([publishedAt])
  @@index([category])
}

enum ContactType {
  SALES
  SUPPORT
  GENERAL
}

model ContactSubmission {
  id        String      @id @default(cuid())
  type      ContactType
  name      String
  email     String
  company   String?
  teamSize  String?
  message   String
  status    String      @default("new")
  ip        String?
  createdAt DateTime    @default(now())

  @@index([createdAt])
}
